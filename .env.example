# =========================================================================
# VARIÁVEIS DE AMBIENTE: Nice Doce Sabor
# Compatível com Next.js (NEXT_PUBLIC_*) e Netlify/Vite (VITE_*)
# =========================================================================

# Supabase - Padrão Next.js
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui

# Supabase - Padrão Vite (compatibilidade com Netlify / Vite)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key-aqui

# Chave de Serviço do Supabase (Apenas servidor / backend)
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# Configurações da Loja
NEXT_PUBLIC_STORE_NAME="Nice Doce Sabor"
NEXT_PUBLIC_STORE_WHATSAPP="5581988896169"
NEXT_PUBLIC_STORE_INSTAGRAM="@nice.doce.sabor"

# Otimização de Imagens
NEXT_PUBLIC_UNOPTIMIZED_IMAGES=false
